{
  "name": "WhistleRef",
  "type": "module",
  "private": true,
  "version": "0.4.0-alpha",
  "description": "WhistleRef WebSocket and Bancho IRC bridge",
  "main": "src/index.js",
  "bin": "dist/bundle.js",
  "scripts": {
    "test": "node test/run.mjs",
    "start": "npm run build --prefix ../client && tsx src/index.js --verbose",
    "bundle": "esbuild src/index.js --bundle --platform=node --outfile=dist/bundle.js",
    "build": "node build.js",
    "build:debug": "node build.js -d",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path ../.prettierignore",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "ansi-colors": "^4.1.3",
    "dbus-next": "^0.10.2",
    "express": "^5.1.0",
    "semver": "^7.8.5",
    "string-width": "^4.2.3",
    "systray2": "^2.1.4",
    "tough-cookie": "^4.1.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.1",
    "@yao-pkg/pkg": "^6.22.0",
    "cli-progress": "^3.12.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "rcedit": "^5.0.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "pkg": {
    "assets": [
      "static/**/*",
      "node_modules/systray2/traybin/**/*",
      "icons/*"
    ],
    "outputPath": "build"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.24.2": true,
    "usocket@0.3.0": true
  }
}
